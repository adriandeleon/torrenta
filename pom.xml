<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.torrenta</groupId>
    <artifactId>torrenta</artifactId>
    <version>0.2.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Torrenta</name>
    <description>A keyboard-first, cross-platform BitTorrent client built on JavaFX</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Indirected through a property: the format is ignored when maven.build.timestamp is
             filtered into a resource directly. -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>

        <javafx.version>27</javafx.version>
        <atlantafx.version>3.0.0</atlantafx.version>
        <spotless.version>3.6.0</spotless.version>
        <palantir.version>2.92.0</palantir.version>
        <jacoco.version>0.8.13</jacoco.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <junit.version>5.14.4</junit.version>
        <junit.platform.version>1.14.4</junit.platform.version>
        <!-- The update check reads a GitHub release payload: a large JSON document with
             user-authored text in it, so it gets a real parser. jackson-core only — no databind —
             and it is a proper JPMS module, so jlink links it without moditect. -->
        <jackson.version>2.22.1</jackson.version>
        <!-- Null checking (CLAUDE.md, "Null annotations"): NullAway, an Error Prone plugin,
             checks every @NullMarked package of the main compile and fails the build on a null it
             cannot prove safe. JSpecify supplies the annotations. Error Prone reaches into javac,
             hence .mvn/jvm.config. Editora's setup. -->
        <jspecify.version>1.0.1</jspecify.version>
        <errorprone.version>2.50.0</errorprone.version>
        <nullaway.version>0.14.2</nullaway.version>

        <!-- The engine: libtorrent (the one behind qBittorrent and Deluge) through SWIG. One core
             jar, plus one jar of native libraries per OS, chosen by the os-* profiles below. The
             core jar does NOT extract the native from the jar: it System.load()s the path in
             -Dlibtorrent4j.jni.path, or falls back to java.library.path. NativeLibrary does the
             extraction. Natives exist for macOS arm64, Linux x86_64 (+ 32-bit arm) and Windows
             x86_64 only. -->
        <libtorrent4j.version>2.1.0-39</libtorrent4j.version>

        <!-- The Linux tray: a StatusNotifierItem over D-Bus (GNOME dropped the legacy AWT tray in
             3.26; Windows and macOS keep the AWT one). Both are proper JPMS modules; dbus-java logs
             through slf4j, routed into j.u.l so a tray failure is not swallowed by the no-op binding. -->
        <dbus.version>5.1.1</dbus.version>
        <slf4j.version>2.0.17</slf4j.version>

        <!-- jpackage wants .icns on macOS, .ico on Windows, .png on Linux; the os-* profiles pick. -->
        <jpackage.icon>${project.basedir}/branding/torrenta.png</jpackage.icon>
        <jpackage.imageName>Torrenta</jpackage.imageName>
        <!-- torrenta-nox, the headless launcher: a console program on Windows, which only it takes. -->
        <jpackage.noxLauncher>${project.basedir}/src/jpackage/torrenta-nox.properties</jpackage.noxLauncher>
        <skip.mac.version.fix>true</skip.mac.version.fix>
        <!-- Installers are minutes of work the dev loop never wants; CI and the release turn them on. -->
        <skip.installers>true</skip.installers>
        <!-- The engine's native library inside the per-OS jar: lib/<arch>/libtorrent4j.<ext>. -->
        <native.arch>x86_64</native.arch>
        <native.ext>so</native.ext>

        <!-- dist profile only -->
        <moditect.version>1.2.2.Final</moditect.version>
        <jpackage.plugin.version>1.6.6</jpackage.plugin.version>

        <!-- Prism pipeline order (-Dprism.order). Set per-OS in the os-* profiles:
             mac=mtl,es2,sw (Metal), windows=d3d,es2,sw, linux=es2,sw. This default covers
             profile-less builds (e.g. plain `mvn test`, which doesn't render). -->
        <prism.pipeline>es2,sw</prism.pipeline>
    </properties>

    <dependencies>
        <!-- Compile-time only (`requires static org.jspecify`): the annotations are read by
             NullAway, and a missing annotation class is ignored by reflection at run time, so
             nothing ships. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Control themes: Nord and Cupertino come from AtlantaFX itself; the Editora pair is
             authored in-house (see NOTICE) on the same variables. -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.libtorrent4j</groupId>
            <artifactId>libtorrent4j</artifactId>
            <version>${libtorrent4j.version}</version>
        </dependency>
        <!-- libtorrent4j-{macos,linux,windows}: see the os-* profiles. -->

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-core</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- For com.torrenta.NativeTeardownSkip, a LauncherSessionListener; the same release as
             the one surefire would pick for this Jupiter. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- build-info.properties is filtered so the version comes from this pom and nowhere
                 else; every other file reads it through AppInfo. A release then means editing one
                 number. Everything else is copied verbatim — filtering the CSS would mangle any
                 ${...} it contains. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>com/torrenta/build-info.properties</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>com/torrenta/build-info.properties</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <!-- The JDK this project is built, tested, packaged and run on. Everything else here is
                 pinned to it (the formatter breaks on 27, the native image is cut from it), and a
                 run under the sdkman default of 27 crashed at quit with a torrent in the list.
                 Pass -Denforcer.skip to try another on purpose. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>jdk-25</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Torrenta builds and runs on JDK 25: set JAVA_HOME to a 25 (sdkman: 25.0.4-tem). JDK 27 breaks the formatter and crashed the app at quit.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <!-- importOrder runs AFTER Palantir so it has the final say on grouping;
                             Palantir otherwise collapses everything into one alphabetical block.
                             Groups, blank-line separated, longest prefix wins so javafx is not
                             swallowed by java: JDK, then javafx, then everything else (third-party
                             and com.torrenta), then static imports last. -->
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <!-- verify, not compile: `mvn javafx:run` and the compile loop stay
                             untouched, and CI still refuses unformatted code. -->
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <!-- A regression net, not a target: each floor sits well below the coverage
                             actually measured. Only packages whose coverage does not depend on the
                             platform or on a display are gated. -->
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <!-- The command line: pure parsing, fully covered. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.torrenta.cli</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <execution>
                        <!-- NullAway only: every other Error Prone check is off. OnlyNullMarked
                             leaves a package unchecked until its package-info.java says
                             @NullMarked. Tests are not checked. -->
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Tests are compiled as a patch of the module, so a JDK module the main
                             code never needs (the HTTP server the fetch test stands up) has to be
                             made readable here. At run time the tests are on the classpath and
                             read everything. -->
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>com.torrenta=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath (unnamed module) so they can reach
                         package-private members and setAccessible freely. -->
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <!-- NativeLibrary unpacks the engine here instead of under ~/.torrenta. -->
                        <torrenta.nativeDir>${project.build.directory}/native</torrenta.nativeDir>
                        <!-- com.torrenta.TestProgress: which test was running when a fork died. -->
                        <torrenta.testProgress>${project.build.directory}/surefire-reports/test-progress.log</torrenta.testProgress>
                    </systemPropertyVariables>
                    <!-- The engine's JNI class calls System.load; see the javafx plugin options.
                         A crash report goes beside the test reports, which CI uploads on failure,
                         rather than into whatever directory the fork happened to start in.
                         NativeTeardownSkip calls _exit through FFM and reads the JDK's table of
                         shutdown hooks, hence the opens. -->
                    <argLine>@{argLine} --enable-native-access=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED -XX:ErrorFile=${project.build.directory}/surefire-reports/hs_err_pid%p.log</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.torrenta/com.torrenta.App</mainClass>
                    <options>
                        <!-- The engine's automatic module calls System.load; without this the JDK
                             warns on every launch and says it will refuse in a future release.
                             ALL-UNNAMED covers the jars this plugin puts on the classpath.
                             com.torrenta reads a piece libtorrent hands over by address (FFM). -->
                        <option>--enable-native-access=com.torrenta,javafx.graphics,libtorrent4j,ALL-UNNAMED</option>
                        <option>-Dprism.order=${prism.pipeline}</option>
                    </options>
                    <launcher>torrenta</launcher>
                    <jlinkImageName>torrenta</jlinkImageName>
                    <jlinkZipName>torrenta</jlinkZipName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/torrenta.icns</jpackage.icon>
                <jpackage.imageName>Torrenta.app</jpackage.imageName>
                <skip.mac.version.fix>false</skip.mac.version.fix>
                <native.arch>arm64</native.arch>
                <native.ext>dylib</native.ext>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.libtorrent4j</groupId>
                    <artifactId>libtorrent4j-macos</artifactId>
                    <version>${libtorrent4j.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/torrenta.ico</jpackage.icon>
                <jpackage.noxLauncher>${project.basedir}/src/jpackage/torrenta-nox-windows.properties</jpackage.noxLauncher>
                <native.ext>dll</native.ext>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.libtorrent4j</groupId>
                    <artifactId>libtorrent4j-windows</artifactId>
                    <version>${libtorrent4j.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties>
                <prism.pipeline>es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/torrenta.png</jpackage.icon>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.libtorrent4j</groupId>
                    <artifactId>libtorrent4j-linux</artifactId>
                    <version>${libtorrent4j.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!--
            Native app image:  mvn clean -Pdist -DskipTests package  =>  target/dist/Torrenta{.app}
            Installers too:    add -Dskip.installers=false            =>  target/installers/

            `clean` matters. jlink's input is built from target/classes, and an incremental compile
            can leave that directory inconsistent with the sources in ways javac will not correct.

            libtorrent4j's core jar is an automatic module (no module-info), and jlink refuses to
            link those: moditect injects a descriptor, and the antrun step overlays the patched jar
            on the plain one so the module path holds exactly one copy.

            The engine's native library is NOT in the image. Its per-OS jar is resources only, and a
            resource in a module is encapsulated unless the package is opened; rather than fight that,
            the library is unpacked here and placed beside the image with jpackage's app-content, and
            the launcher hands libtorrent4j its path. NativeLibrary sees the property set and does
            nothing, so the installed app never writes under ~/.torrenta/native.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.moditect</groupId>
                        <artifactId>moditect-maven-plugin</artifactId>
                        <version>${moditect.version}</version>
                        <executions>
                            <execution>
                                <id>patch-automatic-modules</id>
                                <phase>package</phase>
                                <goals><goal>add-module-info</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                    <overwriteExistingFiles>true</overwriteExistingFiles>
                                    <jdepsExtraArgs>
                                        <arg>--multi-release=25</arg>
                                        <arg>--ignore-missing-deps</arg>
                                    </jdepsExtraArgs>
                                    <modules>
                                        <module>
                                            <artifact>
                                                <groupId>org.libtorrent4j</groupId>
                                                <artifactId>libtorrent4j</artifactId>
                                                <version>${libtorrent4j.version}</version>
                                            </artifact>
                                            <moduleInfo>
                                                <name>libtorrent4j</name>
                                                <!-- Every package, so the swig and alerts packages
                                                     the engine imports are reachable. -->
                                                <exports>*;</exports>
                                            </moduleInfo>
                                        </module>
                                    </modules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>collect-modules</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/mods</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                    <!-- The native jar is resources only; it goes beside the image. -->
                                    <excludeArtifactIds>libtorrent4j-linux,libtorrent4j-macos,libtorrent4j-windows</excludeArtifactIds>
                                </configuration>
                            </execution>
                            <execution>
                                <id>unpack-native</id>
                                <phase>package</phase>
                                <goals><goal>unpack-dependencies</goal></goals>
                                <configuration>
                                    <includeArtifactIds>libtorrent4j-linux,libtorrent4j-macos,libtorrent4j-windows</includeArtifactIds>
                                    <includes>lib/${native.arch}/libtorrent4j.${native.ext}</includes>
                                    <outputDirectory>${project.build.directory}/native-unpacked</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <!-- jpackage will not accept a version it cannot parse, and macOS
                                     refuses one whose first number is zero; both handled here rather
                                     than by hardcoding, so Finder, About and the update check agree. -->
                                <id>derive-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <string value="${project.version}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-SNAPSHOT$" replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <loadresource property="jpackage.macVersion">
                                            <string value="${jpackage.publicVersion}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="^0\." replace="1."/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <condition property="jpackage.appVersion"
                                                   value="${jpackage.macVersion}"
                                                   else="${jpackage.publicVersion}">
                                            <os family="mac"/>
                                        </condition>
                                        <echo message="version ${project.version}: public ${jpackage.publicVersion}, bundle ${jpackage.appVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>assemble-module-path</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!-- Patched jars win over the plain automatic ones. -->
                                        <copy todir="${project.build.directory}/mods" overwrite="true">
                                            <fileset dir="${project.build.directory}/modules"/>
                                        </copy>
                                        <copy todir="${project.build.directory}/mods"
                                              file="${project.build.directory}/${project.build.finalName}.jar"/>
                                        <!-- JavaFX publishes a stub jar plus a platform-classifier jar
                                             with the real classes. Both declare the same module, so
                                             leaving both on the path is a duplicate-module error. -->
                                        <delete>
                                            <fileset dir="${project.build.directory}/mods"
                                                     includes="javafx-*-${javafx.version}.jar"/>
                                        </delete>
                                        <!-- The native, under a stable name next to the image. -->
                                        <copy todir="${project.build.directory}/native/torrenta-native" overwrite="true">
                                            <fileset dir="${project.build.directory}/native-unpacked/lib/${native.arch}"
                                                     includes="libtorrent4j.${native.ext}"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>${jpackage.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>app-image</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>Torrenta</name>
                                    <appVersion>${jpackage.appVersion}</appVersion>
                                    <vendor>Adrian De Leon</vendor>
                                    <icon>${jpackage.icon}</icon>
                                    <destination>${project.build.directory}/dist</destination>
                                    <module>com.torrenta/com.torrenta.App</module>
                                    <!-- The same image without a window: torrenta-nox runs App with
                                         the headless flag, for a server and the systemd unit in docs. -->
                                    <launchers>
                                        <launcher>
                                            <name>torrenta-nox</name>
                                            <file>${jpackage.noxLauncher}</file>
                                        </launcher>
                                    </launchers>
                                    <modulePaths>
                                        <modulePath>${project.build.directory}/mods</modulePath>
                                    </modulePaths>
                                    <!-- Copied into the image's content directory: lib/ on Linux,
                                         Contents/ on macOS, the root on Windows. $APPDIR is one
                                         level below each of those, hence the ".." in the option. -->
                                    <appContentPaths>
                                        <appContentPath>${project.build.directory}/native/torrenta-native</appContentPath>
                                    </appContentPaths>
                                    <javaOptions>
                                        <javaOption>--enable-native-access=com.torrenta,javafx.graphics,libtorrent4j</javaOption>
                                        <javaOption>-Dprism.order=${prism.pipeline}</javaOption>
                                        <javaOption>-Dlibtorrent4j.jni.path=$APPDIR/../torrenta-native/libtorrent4j.${native.ext}</javaOption>
                                        <!-- A ceiling, not a tuning claim: without it the JVM takes a
                                             quarter of RAM as its maximum heap. -->
                                        <javaOption>-Xmx1g</javaOption>
                                        <!-- Returns idle memory to the OS; off by default in G1. -->
                                        <javaOption>-XX:G1PeriodicGCInterval=30000</javaOption>
                                    </javaOptions>
                                    <jLinkOptions>
                                        <jLinkOption>--strip-debug</jLinkOption>
                                        <jLinkOption>--no-man-pages</jLinkOption>
                                        <jLinkOption>--no-header-files</jLinkOption>
                                        <jLinkOption>--compress=zip-6</jLinkOption>
                                    </jLinkOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <!-- After jpackage (same phase, POM order), since it edits the bundle. -->
                                <id>fix-mac-bundle-version</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/fix-mac-bundle-version.sh</argument>
                                        <argument>${project.build.directory}/dist/Torrenta.app</argument>
                                        <argument>${jpackage.publicVersion}</argument>
                                    </arguments>
                                    <skip>${skip.mac.version.fix}</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Also edits the bundle: the .torrent document type (jpackage
                                     takes file associations only for installer types, and the dmg
                                     wraps the image as it is) and the magnet: URL scheme, which
                                     jpackage cannot declare at all. -->
                                <id>add-mac-types</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/add-mac-types.sh</argument>
                                        <argument>${project.build.directory}/dist/Torrenta.app</argument>
                                    </arguments>
                                    <skip>${skip.mac.version.fix}</skip>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Last, so it wraps a finished image. -->
                                <id>build-installers</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/build-installers.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>${jpackage.appVersion}</argument>
                                        <argument>${project.build.directory}/installers</argument>
                                        <argument>${jpackage.icon}</argument>
                                    </arguments>
                                    <skip>${skip.installers}</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
