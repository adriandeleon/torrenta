<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the Developer ID signed Torrenta.app (scripts/sign-mac-app.sh signs
  with this file when TORRENTA_MAC_SIGN_IDENTITY is set). Notarization requires the hardened runtime,
  and a JVM cannot run under it without these two:
    allow-jit                        HotSpot's JIT maps its code cache with MAP_JIT.
    allow-unsigned-executable-memory the JVM writes executable stubs and adapters outside MAP_JIT regions.
  Library validation stays ON: the only native library outside the runtime is libtorrent4j, which ships
  inside the bundle (Contents/torrenta-native) and is signed with the same team ID as the app.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
